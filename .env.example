# Runtime account: no schema/migration privileges.
DATABASE_URL="postgresql://ureport_app:REPLACE_WITH_RUNTIME_PASSWORD@DB_HOST:5432/ureport?sslmode=verify-full"
APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_MINIMUM_32_CHARACTERS"
UREPORT_SETUP_TOKEN="REPLACE_WITH_RANDOM_TOKEN_MINIMUM_32_CHARACTERS"
STORAGE_DIR="storage"
STORAGE_QUOTA_BYTES="1073741824"
MIN_FREE_BYTES="268435456"
TRUST_PROXY="false"
# Operator-selected allowances; fill before Company onboarding. No paid plan implied.
HEARDESK_DEFAULT_WEBSITES=""
HEARDESK_DEFAULT_SEATS=""
HEARDESK_DEFAULT_MONTHLY_REPORTS=""
HEARDESK_DEFAULT_STORAGE_BYTES=""
HEARDESK_EMAIL_MODE="local"
HEARDESK_EMAIL_DIR="storage/mailbox"
HEARDESK_LOCAL_SIGNUP="false"
