generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum FeedbackType {
  ISSUE
  SUGGESTION
  COMPLIMENT
}
enum FeedbackStatus {
  NEW
  REVIEWING
  DONE
  ARCHIVED
}
enum PlatformRole {
  USER
  PLATFORM_OWNER
}
enum CompanyStatus {
  ACTIVE
  SUSPENDED
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  platformRole PlatformRole @default(USER)
  accountStatus String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  notes InternalNote[]
  installation Installation?
  memberships Member[]
  invitations Invitation[]
  companyRequests CompanyCreationRequest[]
  auditEvents AuditEvent[]
  @@map("user")
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  activeOrganizationId String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("session")
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@map("account")
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
  @@map("verification")
}
model RateLimit {
  id String @id @default(cuid())
  key String @unique
  count Int
  lastRequest BigInt
  @@map("rateLimit")
}
model Installation {
  id Int @id @default(1)
  adminId String @unique
  admin User @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())
}
model Site {
  id Int @id @default(autoincrement())
  companyId String
  company Organization @relation(fields: [companyId], references: [id])
  name String
  origin String
  publicKey String @unique
  buttonLabel String @default("Beri masukan")
  position String @default("right")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  feedback Feedback[]
  reservations ReportReservation[]
  @@unique([companyId, origin])
  @@index([companyId])
}
model Feedback {
  id String @id @default(cuid())
  siteId Int
  site Site @relation(fields: [siteId], references: [id])
  submissionId String
  fingerprint String
  type FeedbackType
  message String
  email String?
  pageUrl String?
  status FeedbackStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attachment Attachment?
  notes InternalNote[]
  @@unique([siteId, submissionId])
  @@index([siteId, createdAt, id])
  @@index([status, type])
}
model Attachment {
  id String @id @default(cuid())
  feedbackId String @unique
  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  key String @unique
  filename String
  mime String
  size Int
  createdAt DateTime @default(now())
}
model InternalNote {
  id String @id @default(cuid())
  feedbackId String
  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  authorId String
  author User @relation(fields: [authorId], references: [id])
  body String
  createdAt DateTime @default(now())
  @@index([feedbackId, createdAt])
}
model RateBucket {
  key String @id
  count Int
  expiresAt DateTime
}
model StorageBudget {
  id Int @id @default(1)
  used BigInt @default(0)
}
model UploadReservation {
  id String @id
  companyId String
  company Organization @relation(fields: [companyId], references: [id])
  bytes BigInt
  createdAt DateTime @default(now())
  @@index([companyId, createdAt])
}
model Organization {
  id String @id
  name String
  slug String @unique
  logo String?
  metadata String?
  createdAt DateTime @default(now())
  members Member[]
  invitations Invitation[]
  profile CompanyProfile?
  sites Site[]
  limits CompanyLimits?
  usage CompanyUsage?
  periods ReportUsagePeriod[]
  reportReservations ReportReservation[]
  uploadReservations UploadReservation[]
  requests CompanyCreationRequest[]
  auditEvents AuditEvent[]
  @@map("organization")
}
model Member {
  id String @id
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  role String
  createdAt DateTime @default(now())
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}
model Invitation {
  id String @id
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  email String
  role String?
  status String @default("pending")
  inviterId String
  inviter User @relation(fields: [inviterId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([organizationId, email, status])
  @@map("invitation")
}
model CompanyProfile {
  organizationId String @id
  organization Organization @relation(fields: [organizationId], references: [id])
  status CompanyStatus @default(ACTIVE)
  statusReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CompanyLimits {
  companyId String @id
  company Organization @relation(fields: [companyId], references: [id])
  websiteLimit Int
  seatLimit Int
  monthlyReportLimit Int
  storageBytesLimit BigInt
}
model CompanyUsage {
  companyId String @id
  company Organization @relation(fields: [companyId], references: [id])
  storedBytes BigInt @default(0)
}
model ReportUsagePeriod {
  companyId String
  company Organization @relation(fields: [companyId], references: [id])
  period String
  count Int @default(0)
  @@id([companyId, period])
}
model ReportReservation {
  id String @id
  companyId String
  company Organization @relation(fields: [companyId], references: [id])
  siteId Int
  site Site @relation(fields: [siteId], references: [id])
  submissionId String
  period String
  expiresAt DateTime
  @@unique([siteId, submissionId])
  @@index([companyId, period])
}
model CompanyCreationRequest {
  userId String
  user User @relation(fields: [userId], references: [id])
  idempotencyKey String
  fingerprint String
  companyId String
  company Organization @relation(fields: [companyId], references: [id])
  @@id([userId, idempotencyKey])
}
model AuditEvent {
  id String @id @default(cuid())
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorSnapshot String
  companyId String?
  company Organization? @relation(fields: [companyId], references: [id])
  action String
  resourceId String
  metadata Json?
  createdAt DateTime @default(now())
  @@index([companyId, createdAt])
}
